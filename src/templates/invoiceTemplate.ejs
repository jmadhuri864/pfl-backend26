<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      line-height: 1.5;
      padding: 20px;
    }

    .invoice-container {
      max-width: 800px;
      margin: 10px auto;
      padding: 0;
    }

    .all-border {
      border: 1px solid black;
    }

    .bottom-border {
      border-bottom: 1px solid black;
    }

    .right-bottom {
      border-right: 1px solid black;
    }

    .flex-center {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .flex-vertical-center {
      display: flex;
      align-items: center;
    }

    .flex-horizontal-center {
      display: flex;
      justify-content: center;
    }

    .bottom-border {
      border-bottom: 1px solid black;
    }

    .right-border {
      border-right: 1px solid black;
    }

    .header-first-row {
      width: 100%;
      height: 30px;
      padding: 0px 10px;
    }

    .header-second-row {
      width: 100%;
      height: 70px;
    }

    .header-third-row {
      width: 100%;
      height: 50px;
      text-align: center;
    }

    .header-fourth-row {
      width: 100%;
      height: 20px;
      text-align: center;
    }

    .customer-address-block {
      width: 100%;
    }

    .customer-address-block div {
      width: 50%;
      padding: 0px 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    th,
    td {
      border: 1px solid black;
    }

    th,
    td {
      text-align: center;
      padding: 8px;
    }

    th {
      background-color: #f2f2f2;
    }

    .total-row {
      font-weight: bold;
    }

    .notes {
      text-align: left;
      vertical-align: top;
    }

    .bank-details {
      width: 100%;
      height: 50px;
      text-align: center;
    }

    .invoice-footer {
      width: 100%;
      height: 200px;
    }

    .terms-condition {
      width: 50%;
      height: inherit;
      padding: 0px 10px;
    }

    .signature-box {
      width: 50%;
      height: inherit
    }

    .receiver-sign-block {
      width: 100%;
      height: 50%;
      display: flex;
      justify-content: center;
      align-items: end;
    }

    .authorized-sign-block {
      width: 100%;
      height: 50%;
      padding: 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }

    .footer-heading {
      display: block;
      width: 100%;
      font-size: 16px;
      font-weight: bold;
    }
  </style>
</head>

<body>
  <div class="invoice-container all-border">
    <header>
      <div class="header-first-row flex-vertical-center bottom-border">
        <span style="font-size: 15px; font-weight: bold;">ORIGINAL COPY</span>
        <span style="margin-left: 200px; font-size: 15px; font-weight: bold;"><%= data.type %> INVOICE</span>
      </div>
      <div class="header-second-row flex-center bottom-border">
        <h1 class="flex-center right-border" style="width: 80%; height: inherit;"><%= data.company %></h1>
        <div class="flex-center" style="width: 20%; height: inherit;">
          <img src="https://aws-sdk-multer.s3.ap-south-1.amazonaws.com/invoices/drawer-logo.png" 
               alt="Company Logo" 
               style="width: 80%; height: auto; max-width: 80%; max-height: 80%;" />
      </div>
      </div>
      <div class="header-third-row bottom-border">
          <p style="font-size:small; font-weight: bold">Regd. & Admin Office : 102, Sanskar-||, Near Ketav Petrol
            Pump, Polytechnic Road, Ambawadi, Ahmedabad - 380015</p>
          <p style="font-size: x-small; font-weight: 600;">Phone: 079-40320244, Email:
            info@primefreshlimited.com</p>
          <p style="font-size: x-small; font-weight: 600;">FSSAI No: 10021021000490 for Ambawadi, FSSAI No:
            10721026000215 for Naroda </p>
      </div>
      <div class="header-fourth-row bottom-border flex-center">
        <span style="font-size: small; font-weight: bold;">V-1210-1220, Prime Fresh Ltd, New Krushi Wholesale Mart, Opp
          Aakashar Business Park Sec19-A Turbhe, Vashi-400703</span>
      </div>
    </header>
    <section>
      <div class="flex-vertical-center bottom-border" style="width: 100%;">
        <div class="right-border" style="width: 50%; padding: 0px 10px;">
          <span style="font-weight: bold; margin-right: 10px;">Invoice No:</span>
          <span><%= data.invoiceNumber %></span>
        </div>
        <div style="width: 50%; padding: 0px 10px">
          <span style="font-weight: bold; margin-right: 10px;">PO Number:</span>
          <span><%= data.poNo %></span>
        </div>
      </div>
      <div class="flex-vertical-center bottom-border" style="width: 100%;">
        <div class="right-border" style="width: 50%; padding: 0px 10px">
          <span style="font-weight: bold; margin-right: 10px;">Invoice Date:</span>
          <span><%= data.invoiceDate %></span>
        </div>
        <div style="width: 50%; padding: 0px 10px">
          <span style="font-weight: bold; margin-right: 10px;">Vehicle No:</span>
          <span><%= data.vehicleNo %></span>
        </div>
      </div>
      <div class="flex-vertical-center bottom-border" style="width: 100%;">
        <div class="right-border" style="width: 50%; padding: 0px 10px">
          <span style="font-weight: bold; margin-right: 10px;">Customer ID:</span>
          <span><%= data.customerCode %></span>
        </div>
        <div style="width: 50%; padding: 0px 10px">
          <span style="font-weight: bold; margin-right: 10px;">Place of Supply:</span>
          <span><%= data.shipToAddress.location %></span>
        </div>
      </div>
    </section>
    <section class="customer-address-block flex-center bottom-border">
      <div class="right-border">
        <h5 style="font-size: small; font-weight: bold;">Billed To:</h5>
        <p style="font-size: large; font-weight: 600;"><%= data.partyName %></p>
        <p style="font-size: medium; font-weight: 500;"><%= data.billToAddress.address1 %>,<%= data.billToAddress.address2 %>,<%= data.billToAddress.location %>,<%= data.billToAddress.city %>,<%= data.billToAddress.state %>,<%= data.billToAddress.pincode %></p>
        <p style="font-size: medium; font-weight: 500;">Contact No:</p>
        <p style="font-size: medium; font-weight: 500;">GSTN:<%= data.gstn %></p>
        <p style="font-size: medium; font-weight: 500;">PAN:<%= data. panNo%></p>
      </div>
      <div>
        <h5 style="font-size: small; font-weight: bold;">Shipped To:</h5>
        <p style="font-size: large; font-weight: 600;"><%= data.partyName %></p>
        <p style="font-size: medium; font-weight: 500;"><%= data.shipToAddress.address1 %>,<%= data.shipToAddress.address2 %>,<%= data.shipToAddress.location %>,<%= data.shipToAddress.city %>,<%= data.shipToAddress.state %>,<%= data.shipToAddress.pincode %></p>
        <p style="font-size: medium; font-weight: 500;">Contact No:</p>
        <p style="font-size: medium; font-weight: 500;">GSTN: <%= data.gstn %></p>
        <p style="font-size: medium; font-weight: 500;">PAN: <%= data. panNo%></p>
      </div>
    </section>
    <section class="item-table">
      <table>
        <thead>
          <tr>
            <th>S.No.</th>
            <th>Description of goods</th>
            <th>HSN/SAC Code</th>
            <th>QTY</th>
            <th>UNIT</th>
            <th>PRICE</th>
            <th>AMOUNT (Rs)</th>
          </tr>
        </thead>
        <tbody>
            <% data.items.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= item.productName %></td>
                    <td></td>
                    <td><%= item.qty %></td>
                    <td><%= item.uom %></td>
                    <td><%= item.rate %></td>
                    <td><%= item.amt%></td>
                </tr>
            <% }); %>

          <tr>
            <td colspan="6" class="total-row" style="text-align: end;">TOTAL</td>
            <td> <%= data.totalAmt %></td>
          </tr>
          <tr>
            <td colspan="6" class="notes" style="text-align: end;">
              <strong>Other Exp. If any</strong><br>
              Transportation<br>
              Unloading Local labour<br>
              Labour charges<br>
            </td>
          </tr>
          <tr>
            <td colspan="6" class="total-row" style="text-align: end;">GRAND TOTAL</td>
            <td> <%= data.totalAmt %></td>
          </tr>
          <tr>
            <td colspan="3" class="total-row" style="text-align:center;">Total Amount In Words: </td>
            <td colspan="3"><%= data.amountInWords%></td>
          </tr>
        </tbody>
      </table>
    </section>
    <section class="bank-details bottom-border">
      <span style="font-size: large; font-weight: bolder;">Bank Details</span>
      <div class="flex-center">
        <div style="margin-right: 10px;">
          <span style="font-size:small; font-weight: bold;">Bank Name:</span>
          <span style="font-size: small;"><%= data.bankDetails.bankName %></span>
        </div>
        <div style="margin-right: 10px;">
          <span style="font-weight: bold;">Account No:</span>
          <span style="font-size: small;"><%= data.bankDetails.accountNo %></span>
        </div>
        <div style="margin-right: 10px;">
          <span style="font-size:small; font-weight: bold;">IFSC:</span>
          <span style="font-size: small;"><%= data.bankDetails.ifsc%></span>
        </div>
        <div>
          <span style="font-size:small; font-weight: bold;">Branch:</span>
          <span style="font-size: small;"><%= data.bankDetails.branch%></span>
        </div>
      </div>
    </section>
    <footer class="invoice-footer flex-center">
      <div class="terms-condition right-border">
        <span class="footer-heading">Terms & Conditions:</span>
        <span style="display: block; width: 100%; ;font-size: small;">1. Goods once sold will not be taken back.</span>
        <span style="display: block; width: 100%; ;font-size: small;">2. Interest @ 24% p.a. will be charged if the
          payment is not made with in the Due Date.</span>
        <span style="display: block; width: 100%; ;font-size: small;">3. Subject to Ahmedabad Jurisdiction only. 
          "This is computar generated invoice No signature required"</span>
      </div>
      <div class="signature-box">
        <div class="receiver-sign-block bottom-border">
          <span class="footer-heading" style="text-align: center;">Receiver Signature</span>
        </div>
        <div class="authorized-sign-block">
          <span class="footer-heading" style="text-align: center;">Company Name</span>
          <span class="footer-heading" style="text-align: center;">Authorized Signature</span>
        </div>
      </div>
    </footer>
  </div>
</body>

</html>